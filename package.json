{
  "name": "updraft",
  "version": "0.1.0",
  "private": true,
  "description": "UPDRAFT \u2014 a one-button kite-flying arcade game. Zero runtime dependencies.",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "22.x",
    "pnpm": "12.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.game.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "budget": "node scripts/bundle-budget.mjs",
    "e2e": "playwright test",
    "feel": "node scripts/run-tool.mjs tools/feel/report.ts",
    "feel:sweep": "node scripts/run-tool.mjs tools/feel/sensitivity.ts",
    "feel:reach": "node scripts/run-tool.mjs tools/feel/reachability.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test:coverage && pnpm build && pnpm budget",
    "feel:tape": "node scripts/run-tool.mjs tools/feel/tape-search.ts",
    "feel:golden": "node scripts/run-tool.mjs tools/feel/record-golden.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  }
}
