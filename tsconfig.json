{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    // Unused *parameters* are ESLint's job (@typescript-eslint/no-unused-vars), so the
    // committed contract stubs can keep their real parameter names before they are
    // implemented. Unused locals stay a type error.
    "noUnusedParameters": false,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  "include": [
    "src",
    "tests",
    "e2e",
    "tools",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ]
}
